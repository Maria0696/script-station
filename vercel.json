{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "master": true
    }
  },
  "rewrites": [
    {
      "source": "/api/telegram",
      "destination": "/api/index?bot=huginn"
    },
    {
      "source": "/api/heimdall",
      "destination": "/api/index?bot=heimdall"
    }
  ]
}