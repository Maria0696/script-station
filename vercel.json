{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)data/'",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "master": true
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/telegram",
      "destination": "/api/index?bot=huginn"
    },
    {
      "source": "/api/heimdall",
      "destination": "/api/index?bot=heimdall"
    },
    {
      "source": "/api/cron",
      "destination": "/api/index?cron=daily"
    }
  ]
}
